.game {
    --surface: #101821;
    --container: #192532;
    --text: #edf2f4;
    --muted: #afbecb;
    --accent: #efc37c;
    --outline: #55697b;
    --danger: #ff918c;
    flex-grow: 1;
    background-color: var(--surface);
    color: var(--text);
    font-size: 16px;
    padding: 24px 32px;
    max-width: 1280px;
    width: 100%;
    align-self: center;
}
.header { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 20px; }
.title { font-size: 30px; -unity-font-style: bold; letter-spacing: 3px; color: var(--accent); margin: 0 0 6px 0; }
.muted { color: var(--muted); white-space: normal; margin-top: 6px; }
.floor-number { font-size: 26px; -unity-font-style: bold; }
.body { flex-direction: row; justify-content: space-between; flex-grow: 1; }
.world { width: 824px; }
.map-heading { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.map-heading, .legend { flex-shrink: 0; }
.section-title { font-size: 14px; -unity-font-style: bold; letter-spacing: 2px; color: var(--accent); margin-top: 10px; margin-bottom: 8px; }
.map-frame { background-color: #080e15; padding: 12px; border-width: 1px; border-color: var(--outline); align-items: center; flex-shrink: 0; }
.map { position: relative; overflow: hidden; flex-shrink: 0; }
.tile, .glyph { position: absolute; }
.wall { background-color: #131e29; border-left-width: 1px; border-top-width: 1px; border-color: #1c2b39; }
.floor-even { background-color: #2c3a46; }
.floor-odd { background-color: #293642; }
.corridor { background-color: #26333f; }
.glyph { margin: 0; padding: 0; }
.player { color: var(--accent); }
.enemy { color: #ffaaa0; }
.item { color: #a5e8cf; }
.stairs { color: #ffffff; background-color: #365448; }
.glyph:focus { border-width: 1px; border-color: #ffffff; background-color: #405568; }
.hit { background-color: #ffffff; color: #101821; }
.legend { font-size: 13px; color: var(--muted); margin-top: 10px; white-space: normal; }
.sidebar { width: 338px; padding: 8px 18px 16px 18px; background-color: var(--container); border-radius: 8px; }
.sidebar > * { flex-shrink: 0; }
.sidebar Button { font-size: 13px; padding: 8px 4px; min-width: 0; }
.sidebar .button-row > Button { flex-basis: 0; margin-right: 4px; }
.sidebar .muted { font-size: 14px; }
.sidebar .equipment { margin-top: 10px; margin-bottom: 8px; }
.sidebar Toggle { margin-top: 0; font-size: 14px; }
.health-text { font-size: 24px; -unity-font-style: bold; margin-top: 8px; }
.health-track { height: 8px; background-color: #080e15; margin-top: 8px; margin-bottom: 8px; border-radius: 4px; }
.health-fill { height: 8px; background-color: #a5e8cf; border-radius: 4px; }
.low-health { background-color: var(--danger); }
.stats { font-size: 19px; white-space: normal; }
.equipment { color: var(--muted); font-size: 14px; white-space: normal; margin-top: 18px; margin-bottom: 14px; }
Button { background-color: #293b4c; color: var(--text); border-width: 1px; border-color: var(--outline); border-radius: 5px; padding: 10px 12px; margin: 4px 0; min-height: 40px; -unity-text-align: middle-center; }
Button:hover { background-color: #3d5367; border-color: var(--accent); }
Button:active { background-color: #52697b; }
.game Button:disabled { opacity: 1; color: #a4b1bd; background-color: #1d2b37; border-color: #334859; }
Toggle { margin-top: 20px; color: var(--muted); }
.unity-toggle__input { border-width: 1px; border-color: var(--outline); min-width: 18px; min-height: 18px; }
.unity-toggle__checkmark { width: 16px; height: 16px; background-color: #101821; }
.unity-toggle__input:checked > .unity-toggle__checkmark { background-color: var(--accent); }
.log-panel { margin-top: 14px; padding: 8px 16px 12px 16px; background-color: var(--container); border-radius: 8px; min-height: 154px; }
.log { font-size: 16px; white-space: normal; }
.pack-panel { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(5, 10, 16, 0.80); }
.pack-card { position: absolute; left: 190px; right: 190px; top: 110px; bottom: 120px; padding: 22px; background-color: #192532; border-width: 2px; border-color: var(--accent); border-radius: 10px; }
.inventory-list { flex-grow: 1; flex-basis: 0; min-height: 100px; }
.inventory-item { -unity-text-align: middle-left; }
.selected { border-width: 2px; border-color: var(--accent); background-color: #344a5d; }
.description { min-height: 48px; margin-top: 12px; white-space: normal; color: var(--muted); flex-shrink: 0; }
.button-row { flex-direction: row; flex-shrink: 0; }
.pack-card > Button, .pack-card > .section-title { flex-shrink: 0; }
.button-row > Button { flex-grow: 1; margin-right: 8px; }
.death-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(5, 10, 16, 0.94); justify-content: center; align-items: center; }
.death-card { width: 620px; padding: 40px; border-width: 1px; border-color: var(--outline); background-color: var(--container); border-radius: 12px; }
.death-summary { font-size: 22px; margin-top: 18px; margin-bottom: 18px; white-space: normal; }
.menu-card { width: 820px; padding: 24px; border-width: 1px; border-color: var(--outline); background-color: var(--container); border-radius: 12px; }
.menu-message { white-space: normal; color: var(--accent); margin-bottom: 12px; }
.menu-card Button { flex-shrink: 0; }
.utility-card { width: 900px; height: 700px; max-height: 95%; padding: 24px; border-width: 1px; border-color: var(--outline); background-color: var(--container); border-radius: 12px; }
.utility-card Button { flex-shrink: 0; }
.floor-number { font-size: 20px; }
