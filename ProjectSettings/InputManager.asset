%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!13 &1
InputManager:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Axes:
  - serializedVersion: 3
    m_Name: Horizontal
    negativeButton: left
    positiveButton: right
    gravity: 3
    dead: 0.001
    sensitivity: 3
    type: 0
    axis: 0
    joyNum: 0
  - serializedVersion: 3
    m_Name: Vertical
    negativeButton: down
    positiveButton: up
    gravity: 3
    dead: 0.001
    sensitivity: 3
    type: 0
    axis: 0
    joyNum: 0
  - serializedVersion: 3
    m_Name: Submit
    positiveButton: return
    altPositiveButton: joystick button 0
    gravity: 1000
    dead: 0.001
    sensitivity: 1000
    type: 0
    axis: 0
    joyNum: 0
  - serializedVersion: 3
    m_Name: Cancel
    positiveButton: escape
    altPositiveButton: joystick button 1
    gravity: 1000
    dead: 0.001
    sensitivity: 1000
    type: 0
    axis: 0
    joyNum: 0
  - serializedVersion: 3
    m_Name: GamepadHorizontal
    gravity: 0
    dead: 0.2
    sensitivity: 1
    snap: 0
    invert: 0
    type: 2
    axis: 0
    joyNum: 0
  - serializedVersion: 3
    m_Name: GamepadVertical
    gravity: 0
    dead: 0.2
    sensitivity: 1
    snap: 0
    invert: 0
    type: 2
    axis: 1
    joyNum: 0
  - serializedVersion: 3
    m_Name: DpadHorizontal
    gravity: 0
    dead: 0.2
    sensitivity: 1
    snap: 0
    invert: 0
    type: 2
    axis: 5
    joyNum: 0
  - serializedVersion: 3
    m_Name: DpadVertical
    gravity: 0
    dead: 0.2
    sensitivity: 1
    snap: 0
    invert: 0
    type: 2
    axis: 6
    joyNum: 0
