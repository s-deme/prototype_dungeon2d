<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsTestProject>true</IsTestProject>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../Assets/Game/Tests/Fixtures/run-v1.bytes" Link="run-v1.bytes" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Assets/Game/Scripts/Domain/**/*.cs" />
    <Compile Include="../Assets/Game/Tests/EditMode/**/*.cs" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>
</Project>
